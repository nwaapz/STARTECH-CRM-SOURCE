<?xml version="1.0" encoding="utf-8"?>
<!-- LAN CRM uses HTTP on private hotspot networks (10.x, 192.168.x, etc.) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
