RewriteEngine On
RewriteBase /crm/

# Pass Authorization to PHP (cPanel/Apache often strips it)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Legacy sync PHP files only (push/pull/manifest). Buffer must hit api/index.php.
RewriteRule ^api/sync/(push|pull|manifest)(/|$) - [L]

# Front-controller for /api/*
RewriteRule ^api/index\.php$ - [L]
RewriteCond %{REQUEST_URI} ^/crm/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Vue SPA
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]
